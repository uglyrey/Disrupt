FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY ai_relay/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt && groupadd --gid 1000 relay && useradd --uid 1000 --gid 1000 --create-home relay
COPY --chown=relay:relay ai_relay ./ai_relay
USER relay
CMD ["python", "-m", "ai_relay"]
